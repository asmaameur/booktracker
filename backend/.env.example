# Copy this file to .env and fill in your own values.
# Never commit .env: it contains passwords and secrets.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Frontend address. Used in email links and allowed by CORS.
# Several addresses can be separated by commas; the first one is used in emails.
CLIENT_URL=http://localhost:5173

# --- PostgreSQL -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=booktracker
# Alternatively, one connection string (hosted databases such as Neon or Render).
# When set, it replaces the DB_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/booktracker?sslmode=require

# --- Login tokens (JWT) ---------------------------------------------------
# A long random secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# --- Email verification ---------------------------------------------------
EMAIL_TOKEN_EXPIRES_HOURS=24
# Leave SMTP_HOST empty during development: emails are then printed in the
# server console instead of being sent.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=your address, SMTP_PASS=a Google "app password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BookTracker <no-reply@booktracker.local>"

# --- Security -------------------------------------------------------------
# Requests allowed per IP address every 15 minutes on /api/auth routes.
AUTH_RATE_LIMIT_MAX=20

# --- First administrator (used by: npm run db:create-admin) ---------------
ADMIN_NAME=Asmaa Meur
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
