          }
        },
        {
          "name": "Book details (reader)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Book details (admin)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Download book PDF",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}/pdf"
          }
        },
        {
          "name": "Create book (admin)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Count of Monte Cristo\",\n  \"author\": \"Alexandre Dumas\",\n  \"description\": \"Wrongly imprisoned, Edmond Dantès escapes and returns as a wealthy stranger to settle his accounts.\",\n  \"category\": \"Adventure\",\n  \"coverImageUrl\": \"https://covers.openlibrary.org/b/isbn/9780140449266-L.jpg\",\n  \"pdfUrl\": \"\",\n  \"publicationYear\": 1844\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('bookId', pm.response.json().book.id);",
                  "  console.log('Saved bookId');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update book (admin)",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/books/{{bookId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Count of Monte Cristo\",\n  \"author\": \"Alexandre Dumas\",\n  \"description\": \"Updated description.\",\n  \"category\": \"Adventure\",\n  \"coverImageUrl\": \"https://covers.openlibrary.org/b/isbn/9780140449266-L.jpg\",\n  \"pdfUrl\": \"\",\n  \"publicationYear\": 1844\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete book (admin)",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}",
            "description": "Returns 409 BOOK_IN_LIBRARIES if readers have this book; use the confirmed version below."
          }
        },
        {
          "name": "Delete book, confirmed (admin)",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}?force=true"
          }
        },
        {
          "name": "Reader cannot create a book (expect 403)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Count of Monte Cristo\",\n  \"author\": \"Alexandre Dumas\",\n  \"description\": \"Wrongly imprisoned, Edmond Dantès escapes and returns as a wealthy stranger to settle his accounts.\",\n  \"category\": \"Adventure\",\n  \"coverImageUrl\": \"https://covers.openlibrary.org/b/isbn/9780140449266-L.jpg\",\n  \"pdfUrl\": \"\",\n  \"publicationYear\": 1844\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Library",
      "item": [
        {
          "name": "My library",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/library"
          }
        },
        {
          "name": "My library, books being read",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/library?status=reading"
          }
        },
        {
          "name": "Add book to library",
          "request": {
            "method": "POST",
            "auth": {
